{% doc %}
  Renders the Athelin storefront footer: brand information, navigation links,
  payment methods, and copyright notice.
{% enddoc %}

<footer class="athelin-footer full-width" {{ block.shopify_attributes }}>
  <div class="athelin-footer__inner">
    <div class="athelin-footer__top">
      <div class="athelin-footer__brand">
        <img
          src="{{ 'athelin-logo.png' | asset_url }}"
          alt="Athelin"
          width="110"
          height="26"
          class="athelin-footer__logo"
        >
        <p class="athelin-footer__about">
          India's premier endurance sports specialist. Garmin, Brooks, Hoka, Oakley, and expert sports gear.
        </p>
      </div>

      <div class="athelin-footer__menu">
        <h4 class="athelin-footer__heading">Explore</h4>
        <div class="athelin-footer__links">
          {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.collections_url }}/garmin">Garmin Watches</a>
            <a href="{{ routes.collections_url }}/running">Running Gear</a>
            <a href="{{ routes.collections_url }}/cycling">Cycling Tech</a>
            <a href="/pages/contact">Contact &amp; Fittings</a>
          {%- endif -%}
        </div>
      </div>

      <div class="athelin-footer__contact">
        <h4 class="athelin-footer__heading">Experience Center</h4>
        <p>Delhi NCR, India</p>
        <p>Expert fitting & consultations available by appointment.</p>
      </div>
    </div>

    <div class="athelin-footer__bottom">
      <div class="athelin-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </div>
      <div class="athelin-footer__payment">
        {%- if block.settings.show_payment_icons -%}
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<style>
.athelin-footer {
  width: 100%;
  max-width: 100%;
  background-color: #0b0c10;
  color: #a0aec0;
  padding: 50px 24px 28px;
  border-top: 1px solid #1a202c;
  font-size: 12px;
  box-sizing: border-box;
}

@media (min-width: 1600px) {
  .athelin-footer {
    padding: 56px 32px 28px;
  }
}

.athelin-footer__inner {
  width: 100%;
  max-width: 100%;
  margin: 0;
  box-sizing: border-box;
}

.athelin-footer__top {
  display: grid;
  grid-template-columns: minmax(280px, 2fr) minmax(180px, 1fr) minmax(240px, 1.5fr);
  gap: 3rem;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.athelin-footer__logo {
  filter: brightness(0) invert(1);
  margin-bottom: 14px;
}

.athelin-footer__about {
  max-width: 420px;
  line-height: 1.6;
  font-size: 11.5px;
  color: #718096;
}

.athelin-footer__heading {
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 14px;
}

.athelin-footer__links {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.athelin-footer__links a {
  color: #a0aec0;
  transition: color 0.2s ease;
  text-decoration: none;
}

.athelin-footer__links a:hover {
  color: #ffffff;
}

.athelin-footer__contact p {
  color: #718096;
  line-height: 1.6;
  margin-bottom: 6px;
}

.athelin-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24px;
  font-size: 11px;
  width: 100%;
  box-sizing: border-box;
}

@media (max-width: 768px) {
  .athelin-footer__top {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .athelin-footer__bottom {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ]
}
{% endschema %}
