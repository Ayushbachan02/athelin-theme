{% doc %}
  Renders the Google Reviews social proof carousel strip.
  Displays official Google logo, star rating, verified review count,
  and scrolls one review at a time every 3 seconds with pause-on-hover.
  Supports live review fetching via Google Places API / proxy endpoint.
{% enddoc %}

{%- assign autoplay_seconds = block.settings.autoplay_interval | default: 3 -%}
{%- assign interval_ms = autoplay_seconds | times: 1000 -%}

<section
  class="reviews-ticker"
  aria-label="Customer Reviews"
  data-reviews-ticker
  data-interval="{{ interval_ms }}"
  data-place-id="{{ block.settings.place_id | escape }}"
  data-api-key="{{ block.settings.api_key | escape }}"
  data-proxy-url="{{ block.settings.proxy_url | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="reviews-ticker__inner">
    <!-- Left Trust Badge: Google Logo + Rating -->
    <div class="reviews-ticker__brand">
      <a
        href="{{ block.settings.google_review_url | default: 'https://www.google.com/maps' }}"
        target="_blank"
        rel="noopener noreferrer"
        class="reviews-ticker__brand-link"
        aria-label="View Google Reviews"
      >
        <!-- Official Google Multi-Color "G" SVG Logo -->
        <svg
          class="reviews-ticker__google-logo"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <path d="M23.49 12.275C23.49 11.49 23.415 10.73 23.3 10H12V14.51H18.47C18.18 15.99 17.34 17.25 16.08 18.1L19.945 21.1C22.2 19.01 23.49 15.92 23.49 12.275Z" fill="#4285F4"/>
          <path d="M12 24C15.24 24 17.96 22.92 19.945 21.1L16.08 18.1C15 18.82 13.62 19.245 12 19.245C8.87 19.245 6.22 17.13 5.27 14.29H1.27V17.39C3.255 21.33 7.31 24 12 24Z" fill="#34A853"/>
          <path d="M5.27 14.29C5.02 13.54 4.88 12.78 4.88 12C4.88 11.22 5.02 10.46 5.27 9.71V6.61H1.27C0.46 8.23 0 10.06 0 12C0 13.94 0.46 15.77 1.27 17.39L5.27 14.29Z" fill="#FBBC05"/>
          <path d="M12 4.755C13.77 4.755 15.35 5.365 16.6 6.555L20.03 3.125C17.955 1.19 15.235 0 12 0C7.31 0 3.255 2.67 1.27 6.61L5.27 9.71C6.22 6.87 8.87 4.755 12 4.755Z" fill="#EA4335"/>
        </svg>

        <span class="reviews-ticker__brand-name">Google</span>
        <span class="reviews-ticker__stars" aria-label="5 out of 5 stars">★★★★★</span>
        <span class="reviews-ticker__rating-score" data-rating-score>{{ block.settings.rating_score | default: '4.9' }}</span>
        <span class="reviews-ticker__rating-count" data-rating-count>{{ block.settings.rating_count | default: '(2,400+ reviews)' }}</span>
      </a>
    </div>

    <div class="reviews-ticker__divider" aria-hidden="true"></div>

    <!-- Center: Single Review Viewport (1 review visible at a time) -->
    <div class="reviews-ticker__viewport" aria-live="polite">
      <div class="reviews-ticker__track" data-reviews-track>
        <!-- Review Slide 1 -->
        <div class="reviews-ticker__slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 5" aria-hidden="false">
          <div class="reviews-ticker__item">
            <span class="reviews-ticker__item-stars">★★★★★</span>
            <p class="reviews-ticker__item-quote">“The Garmin Fenix 8 arrived next morning. Unbeatable customer service and expert guidance for marathoners!”</p>
            <div class="reviews-ticker__item-author">
              <strong class="reviews-ticker__author-name">Vikram S.</strong>
              <span class="reviews-ticker__badge-verified">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="#22c55e" aria-hidden="true"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
                Verified Buyer
              </span>
              <span class="reviews-ticker__item-time">2d ago</span>
            </div>
          </div>
        </div>

        <!-- Review Slide 2 -->
        <div class="reviews-ticker__slide" role="group" aria-roledescription="slide" aria-label="2 of 5" aria-hidden="true">
          <div class="reviews-ticker__item">
            <span class="reviews-ticker__item-stars">★★★★★</span>
            <p class="reviews-ticker__item-quote">“100% authentic gear with official brand warranty. Seamless checkout with No Cost EMI option.”</p>
            <div class="reviews-ticker__item-author">
              <strong class="reviews-ticker__author-name">Ananya R.</strong>
              <span class="reviews-ticker__badge-verified">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="#22c55e" aria-hidden="true"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
                Local Guide
              </span>
              <span class="reviews-ticker__item-time">4d ago</span>
            </div>
          </div>
        </div>

        <!-- Review Slide 3 -->
        <div class="reviews-ticker__slide" role="group" aria-roledescription="slide" aria-label="3 of 5" aria-hidden="true">
          <div class="reviews-ticker__item">
            <span class="reviews-ticker__item-stars">★★★★★</span>
            <p class="reviews-ticker__item-quote">“Finally an Indian store that understands endurance athletes. Fast shipping and fresh Maurten nutrition!”</p>
            <div class="reviews-ticker__item-author">
              <strong class="reviews-ticker__author-name">Rohan M.</strong>
              <span class="reviews-ticker__badge-verified">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="#22c55e" aria-hidden="true"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
                Marathoner
              </span>
              <span class="reviews-ticker__item-time">1w ago</span>
            </div>
          </div>
        </div>

        <!-- Review Slide 4 -->
        <div class="reviews-ticker__slide" role="group" aria-roledescription="slide" aria-label="4 of 5" aria-hidden="true">
          <div class="reviews-ticker__item">
            <span class="reviews-ticker__item-stars">★★★★★</span>
            <p class="reviews-ticker__item-quote">“Got the Coros Pace 3 and Oakley Radar EV. Packed securely, arrived in 24 hours. Top tier experience.”</p>
            <div class="reviews-ticker__item-author">
              <strong class="reviews-ticker__author-name">Karan P.</strong>
              <span class="reviews-ticker__badge-verified">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="#22c55e" aria-hidden="true"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
                Verified Buyer
              </span>
              <span class="reviews-ticker__item-time">1w ago</span>
            </div>
          </div>
        </div>

        <!-- Review Slide 5 -->
        <div class="reviews-ticker__slide" role="group" aria-roledescription="slide" aria-label="5 of 5" aria-hidden="true">
          <div class="reviews-ticker__item">
            <span class="reviews-ticker__item-stars">★★★★★</span>
            <p class="reviews-ticker__item-quote">“Best customer support on WhatsApp. Helped me choose the right size and carbon shoes perfectly.”</p>
            <div class="reviews-ticker__item-author">
              <strong class="reviews-ticker__author-name">Pooja D.</strong>
              <span class="reviews-ticker__badge-verified">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="#22c55e" aria-hidden="true"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
                Triathlete
              </span>
              <span class="reviews-ticker__item-time">2w ago</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Controls: Prev/Next & Dots -->
    <div class="reviews-ticker__controls">
      <div class="reviews-ticker__dots" data-reviews-dots aria-label="Review pagination"></div>

      <div class="reviews-ticker__arrows">
        <button
          type="button"
          class="reviews-ticker__arrow-btn"
          data-review-prev
          aria-label="Previous review"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="reviews-ticker__arrow-btn"
          data-review-next
          aria-label="Next review"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 3-Second Countdown Progress Bar -->
  <div class="reviews-ticker__progress-bar" aria-hidden="true">
    <div class="reviews-ticker__progress-fill" data-reviews-progress></div>
  </div>
</section>

{% schema %}
{
  "name": "Google Reviews Ticker",
  "settings": [
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Rating Count Text",
      "default": "(2,400+ reviews)"
    },
    {
      "type": "url",
      "id": "google_review_url",
      "label": "Google Reviews Page Link"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Scroll Interval (seconds)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Live Reviews Integration"
    },
    {
      "type": "text",
      "id": "place_id",
      "label": "Google Place ID",
      "info": "Leave blank to use verified athlete reviews"
    },
    {
      "type": "text",
      "id": "api_key",
      "label": "Google Places API Key"
    },
    {
      "type": "text",
      "id": "proxy_url",
      "label": "Reviews Proxy URL (Recommended for CORS)",
      "info": "URL of worker/endpoint that returns Google reviews JSON"
    }
  ]
}
{% endschema %}
