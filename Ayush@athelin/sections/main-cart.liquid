{% comment %}
  Athelin Main Cart Section
  Controllable via Shopify Theme Editor schema
{% endcomment %}

{%- assign threshold_val = section.settings.free_shipping_threshold | default: 2000 -%}
{%- assign free_shipping_threshold = threshold_val | times: 100 -%}
{%- assign cart_total = cart.total_price | default: 0 -%}
{%- assign remaining_for_free_shipping = free_shipping_threshold | minus: cart_total -%}
{%- if remaining_for_free_shipping < 0 -%}
  {%- assign remaining_for_free_shipping = 0 -%}
{%- endif -%}
{%- assign shipping_progress = cart_total | times: 100 | divided_by: free_shipping_threshold -%}
{%- if shipping_progress > 100 -%}
  {%- assign shipping_progress = 100 -%}
{%- endif -%}

<div class="section-main-cart" {{ section.shopify_attributes }}>
  <div class="cart-page" data-cart-page>
    <!-- 1. Breadcrumbs -->
    <nav class="cart-breadcrumbs" aria-label="Breadcrumb">
      <ol class="cart-breadcrumbs__list">
        <li><a href="{{ routes.root_url }}" class="cart-breadcrumbs__link">Home</a></li>
        <li class="cart-breadcrumbs__sep" aria-hidden="true">/</li>
        <li><span class="cart-breadcrumbs__current" aria-current="page">Shopping Bag</span></li>
      </ol>
    </nav>

    <!-- 2. Cart Hero Header -->
    <div class="cart-hero">
      <div class="cart-hero__left">
        <h1 class="cart-hero__title">
          Your Gear Bag
          <span class="cart-hero__badge" data-cart-page-count>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
        </h1>
        <p class="cart-hero__subtitle">
          Authorised dealer warranty registered at dispatch · 10-day hassle-free returns
        </p>
      </div>
      <div class="cart-hero__right">
        <a href="{{ routes.all_products_collection_url }}" class="cart-hero__continue">
          ← Continue Shopping
        </a>
      </div>
    </div>

    <!-- 3. Cart Main Content -->
    <div
      class="cart-layout"
      data-cart-page-content
      {% if cart.item_count == 0 %}style="display: none;"{% endif %}
    >
      <div class="cart-main">
        <!-- Free Shipping Banner -->
        <div class="cart-shipping-banner">
          <div class="cart-shipping-banner__top">
            <div class="cart-shipping-banner__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div class="cart-shipping-banner__text" data-cart-page-shipping-text>
              {%- if remaining_for_free_shipping > 0 -%}
                Add <strong>{{ remaining_for_free_shipping | money }}</strong> more to unlock <strong>FREE Express Shipping</strong>
              {%- else -%}
                You've unlocked <strong>FREE Express Courier Shipping</strong> &amp; Same-Day Dispatch!
              {%- endif -%}
            </div>
          </div>
          <div class="cart-shipping-banner__track">
            <div
              class="cart-shipping-banner__fill{% if remaining_for_free_shipping == 0 %} is-complete{% endif %}"
              data-cart-page-shipping-fill
              style="width: {{ shipping_progress }}%;"
            ></div>
          </div>
        </div>

        <!-- Cart Form & Line Items -->
        <form action="{{ routes.cart_url }}" method="post" id="cart-page-form" class="cart-items-form">
          <div class="cart-items-header">
            <span>Product</span>
            <span class="cart-items-header__qty">Quantity</span>
            <span class="cart-items-header__total">Total</span>
          </div>

          <div class="cart-items-list" data-cart-page-items>
            {%- for item in cart.items -%}
              {%- assign item_emi = item.final_line_price | divided_by: 3 -%}
              <div class="cart-item-card" data-cart-page-item="{{ item.key }}">
                <div class="cart-item-card__product">
                  <a href="{{ item.url }}" class="cart-item-card__img-link">
                    {%- if item.image -%}
                      <img
                        src="{{ item.image | image_url: width: 280 }}"
                        alt="{{ item.title | escape }}"
                        width="96"
                        height="96"
                        class="cart-item-card__img"
                        loading="lazy"
                      >
                    {%- else -%}
                      <img
                        src="{{ 'product-garmin-1.png' | asset_url }}"
                        alt="{{ item.title | escape }}"
                        width="96"
                        height="96"
                        class="cart-item-card__img"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </a>

                  <div class="cart-item-card__meta">
                    <div class="cart-item-card__vendor-row">
                      <span class="cart-item-card__vendor">{{ item.vendor | default: 'ATHELIN' }}</span>
                      <span class="cart-item-card__stock-badge">
                        <span class="cart-item-card__stock-dot"></span> In stock
                      </span>
                    </div>

                    <h3 class="cart-item-card__title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h3>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-item-card__variant">Option: <strong>{{ item.variant.title }}</strong></p>
                    {%- endunless -%}

                    <div class="cart-item-card__unit-price">
                      {{ item.final_price | money }}
                      {%- if item.original_price > item.final_price -%}
                        <span class="cart-item-card__compare-price">{{ item.original_price | money }}</span>
                      {%- endif -%}
                    </div>

                    <div class="cart-item-card__mobile-actions">
                      <button
                        type="button"
                        class="cart-item-card__action-link"
                        data-cart-save-wishlist
                        data-product-id="{{ item.product.id }}"
                        data-product-handle="{{ item.product.handle | escape }}"
                        data-product-title="{{ item.product.title | escape }}"
                        data-product-vendor="{{ item.vendor | default: 'ATHELIN' | escape }}"
                        data-product-url="{{ item.url | escape }}"
                        data-product-image="{% if item.image %}{{ item.image | image_url: width: 600 }}{% else %}{{ 'product-garmin-1.png' | asset_url }}{% endif %}"
                        data-product-price="{{ item.final_price | money | strip_html | escape }}"
                        data-product-emi="{{ item.final_price | divided_by: 3 | money | strip_html | append: '/mo' | escape }}"
                        data-variant-id="{{ item.variant_id }}"
                        data-line-key="{{ item.key }}"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        Save for later
                      </button>
                      <span class="cart-item-card__dot">·</span>
                      <a
                        href="{{ item.url_to_remove }}"
                        class="cart-item-card__action-link cart-item-card__action-link--remove"
                        data-cart-page-remove="{{ item.key }}"
                      >
                        Remove
                      </a>
                    </div>
                  </div>
                </div>

                <!-- Quantity Stepper -->
                <div class="cart-item-card__qty-col">
                  <div class="cart-qty-stepper">
                    <button
                      type="button"
                      class="cart-qty-stepper__btn"
                      data-cart-page-minus="{{ item.key }}"
                      data-current-qty="{{ item.quantity }}"
                      aria-label="Decrease quantity for {{ item.product.title | escape }}"
                    >
                      −
                    </button>
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="cart-qty-stepper__input"
                      data-cart-page-input="{{ item.key }}"
                      aria-label="Quantity for {{ item.product.title | escape }}"
                    >
                    <button
                      type="button"
                      class="cart-qty-stepper__btn"
                      data-cart-page-plus="{{ item.key }}"
                      data-current-qty="{{ item.quantity }}"
                      aria-label="Increase quantity for {{ item.product.title | escape }}"
                    >
                      +
                    </button>
                  </div>
                </div>

                <!-- Line Item Total + EMI -->
                <div class="cart-item-card__total-col">
                  <span class="cart-item-card__line-price" data-cart-item-line-price>{{ item.final_line_price | money }}</span>
                  <span class="cart-item-card__line-emi" data-cart-item-line-emi>or {{ item_emi | money }}/mo EMI</span>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <!-- Order Notes / Fitting Instructions -->
          {%- if section.settings.show_order_notes -%}
            <div class="cart-notes-card">
              <label for="CartSpecialInstructions" class="cart-notes-card__label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Add order note, custom shoe sizing request, or gift instructions
              </label>
              <textarea
                name="note"
                id="CartSpecialInstructions"
                class="cart-notes-card__textarea"
                placeholder="E.g. Please register Garmin warranty under my name, or call before delivery..."
              >{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
        </form>
      </div>

      <!-- Right Column: Sticky Order Summary -->
      <aside class="cart-summary">
        <div class="cart-summary__card">
          <h2 class="cart-summary__title">Order Summary</h2>

          <!-- Delivery Estimator -->
          {%- if section.settings.show_pincode_estimator -%}
            <div class="cart-summary__delivery">
              <div class="cart-summary__delivery-info">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>Deliver to <strong data-cart-pincode-val>121003</strong> · <span data-cart-delivery-est>2–4 business days</span></span>
              </div>
              <button type="button" class="cart-summary__pincode-btn" data-cart-pincode-btn>Change</button>
            </div>
          {%- endif -%}

          <!-- Breakdown Rows -->
          <div class="cart-summary__rows">
            <div class="cart-summary__row">
              <span>Subtotal (<span data-cart-summary-count>{{ cart.item_count }}</span> items)</span>
              <span data-cart-summary-subtotal>{{ cart.original_total_price | money }}</span>
            </div>

            {%- if cart.total_discount > 0 -%}
              <div class="cart-summary__row cart-summary__row--discount">
                <span>Gear Discount</span>
                <span>−{{ cart.total_discount | money }}</span>
              </div>
            {%- endif -%}

            <div class="cart-summary__row">
              <span>Insured Express Shipping</span>
              <span class="cart-summary__shipping-val" data-cart-summary-shipping>
                {%- if remaining_for_free_shipping == 0 -%}
                  <strong style="color: #10b981;">FREE</strong>
                {%- else -%}
                  Calculated at checkout
                {%- endif -%}
              </span>
            </div>

            <div class="cart-summary__row">
              <span>Official Brand Warranty</span>
              <span style="color: #10b981; font-weight: 600;">Included</span>
            </div>
          </div>

          <div class="cart-summary__divider"></div>

          <!-- Total & Lime EMI Pill -->
          <div class="cart-summary__total-wrap">
            <div class="cart-summary__total-row">
              <div>
                <span class="cart-summary__total-label">Estimated Total</span>
                <span class="cart-summary__tax-note">Inclusive of all GST &amp; duties</span>
              </div>
              <span class="cart-summary__total-price" data-cart-summary-total>{{ cart.total_price | money }}</span>
            </div>

            {%- assign total_emi = cart.total_price | divided_by: 3 -%}
            <div class="cart-summary__emi-pill">
              <span>or <strong data-cart-summary-emi>{{ total_emi | money }}/mo</strong> · 3-Month No Cost EMI</span>
              <span title="Available across major credit cards &amp; UPI at checkout">ⓘ</span>
            </div>
          </div>

          <!-- Checkout CTA -->
          <button
            type="submit"
            name="checkout"
            form="cart-page-form"
            class="cart-summary__checkout-btn"
          >
            <span>Proceed to Secure Checkout</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>

          <!-- Trust & Payment Badges -->
          {%- if section.settings.show_trust_guarantees -%}
            <div class="cart-summary__trust">
              <div class="cart-summary__payment-row">
                <span>Pay securely via UPI, Cards or EMI</span>
                <div class="product-buy-box__payment-icons">
                  <svg class="product-buy-box__payment-icon" viewBox="0 0 38 24" fill="none" aria-label="UPI">
                    <rect width="38" height="24" rx="4" fill="#097939"/>
                    <path d="M19 6L24 18H20.5L19 14.5H15L19 6Z" fill="#FFFFFF"/>
                  </svg>
                  <svg class="product-buy-box__payment-icon" viewBox="0 0 38 24" fill="none" aria-label="GPay">
                    <rect width="38" height="24" rx="4" fill="#5F6368"/>
                    <path d="M12 12C12 8.7 14.7 6 18 6C19.7 6 21.1 6.7 22.1 7.7L20.2 9.6C19.6 9 18.9 8.7 18 8.7C16.2 8.7 14.7 10.2 14.7 12C14.7 13.8 16.2 15.3 18 15.3C19.3 15.3 20.3 14.6 20.7 13.7H18V11.2H23.2C23.3 11.6 23.4 12 23.4 12.5C23.4 15.8 21.1 18 18 18C14.7 18 12 15.3 12 12Z" fill="#FFFFFF"/>
                  </svg>
                  <svg class="product-buy-box__payment-icon" viewBox="0 0 38 24" fill="none" aria-label="Paytm">
                    <rect width="38" height="24" rx="4" fill="#002E6E"/>
                    <circle cx="19" cy="12" r="5" fill="#00BAF2"/>
                  </svg>
                </div>
              </div>

              <ul class="cart-summary__guarantees">
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  100% Authentic — Authorised Dealer for every brand
                </li>
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  10-day easy exchange &amp; returns (we cover courier)
                </li>
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Need sizing help? <a href="https://wa.me/919811981110?text=Hi%20Athelin%2C%20I%20need%20help%20with%20my%20cart%20order" target="_blank" rel="noopener noreferrer">Chat with our specialists on WhatsApp</a>
                </li>
              </ul>
            </div>
          {%- endif -%}
        </div>
      </aside>
    </div>

    <!-- 4. Empty Cart State -->
    <div
      class="cart-empty-state"
      data-cart-page-empty
      {% if cart.item_count > 0 %}style="display: none;"{% endif %}
    >
      <div class="cart-empty-state__icon">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <h2 class="cart-empty-state__title">{{ section.settings.empty_cart_title | default: 'Your gear bag is currently empty' }}</h2>
      <p class="cart-empty-state__desc">
        {{ section.settings.empty_cart_desc | default: "Whether you're training for your first 10K, a full Ironman, or a trail ultra, we have the verified performance gear to get you to the finish line." }}
      </p>
      <div class="cart-empty-state__actions">
        <a href="{{ routes.collections_url }}/garmin" class="btn-pill btn-pill--dark">Explore Garmin Watches</a>
        <a href="{{ routes.collections_url }}/running" class="btn-pill btn-pill--outline">Shop Running Shoes</a>
        <a href="/pages/wishlist" class="btn-pill btn-pill--outline">View Saved Wishlist</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "header",
      "content": "Shipping & Estimator"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free Shipping Threshold (in ₹)",
      "default": 2000
    },
    {
      "type": "checkbox",
      "id": "show_pincode_estimator",
      "label": "Show Delivery Pincode Estimator",
      "default": true
    },
    {
      "type": "header",
      "content": "Cart Form & Features"
    },
    {
      "type": "checkbox",
      "id": "show_order_notes",
      "label": "Show Order Notes Textarea",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_guarantees",
      "label": "Show Trust Guarantees List",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty Cart State"
    },
    {
      "type": "text",
      "id": "empty_cart_title",
      "label": "Empty State Title",
      "default": "Your gear bag is currently empty"
    },
    {
      "type": "textarea",
      "id": "empty_cart_desc",
      "label": "Empty State Description",
      "default": "Whether you're training for your first 10K, a full Ironman, or a trail ultra, we have the verified performance gear to get you to the finish line."
    }
  ]
}
{% endschema %}

