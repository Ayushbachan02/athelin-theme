{% comment %}
  Renders the Athelin Our Store & Experience Center section with Google Shop image carousel,
  route simulation engine, interactive map, in-store labs, and appointment booking form.
  Exposes comprehensive Theme Editor schema controls.
{% endcomment %}

<section class="section-contact-store" {{ section.shopify_attributes }}>
  {% render 'contact-content', settings: section.settings %}
</section>

