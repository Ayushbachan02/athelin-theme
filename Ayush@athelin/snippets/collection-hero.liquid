{% doc %}
  Renders the collection hero banner with dynamic category background,
  breadcrumb navigation, headline, and product catalog metadata.

  @param {collection} [collection] - The Shopify collection object
  @param {string} [title] - Optional title override
  @param {string} [subtitle] - Optional subtitle override
  @param {string} [parent_title] - Optional breadcrumb parent title
  @param {string} [parent_url] - Optional breadcrumb parent URL
  @param {boolean} [show_search_bar] - Optional inline search bar inside hero
  @param {string} [search_terms] - Optional search query string
  @param {boolean} [is_wishlist] - Optional flag for wishlist dynamic counter
{% enddoc %}

{%- assign coll_handle = collection.handle | default: '' | downcase -%}
{%- assign coll_title_raw = collection.title | default: 'Collection' -%}
{%- assign hero_title = title | default: coll_title_raw -%}
{%- assign hero_count = collection.all_products_count | default: collection.products.size | default: 0 -%}

{%- assign parent_nav_title = parent_title | default: 'Collections' -%}
{%- assign parent_nav_url = parent_url | default: routes.all_products_collection_url -%}
{%- assign hero_bg_asset = 'collection-hero-runner.jpg' -%}
{%- assign default_subtext = hero_count | append: ' products in this collection' -%}

{%- if coll_handle contains 'garmin' or coll_handle contains 'watch' or hero_title contains 'watch' or hero_title contains 'Watch' -%}
  {%- assign parent_nav_title = parent_title | default: 'Watches' -%}
  {%- assign parent_nav_url = parent_url | default: routes.collections_url | append: '/garmin' -%}
  {%- assign hero_bg_asset = 'athelin-hero-watches.png' -%}
  {%- assign default_subtext = hero_count | append: ' GPS smartwatches from Garmin' -%}
{%- elsif coll_handle contains 'running' or coll_handle contains 'shoe' or coll_handle contains 'hoka' or coll_handle contains 'brooks' or coll_handle contains 'saucony' or hero_title contains 'Running' or hero_title contains 'Shoes' -%}
  {%- assign parent_nav_title = parent_title | default: 'Run' -%}
  {%- assign parent_nav_url = parent_url | default: routes.collections_url | append: '/running' -%}
  {%- assign hero_bg_asset = 'collection-hero-runner.jpg' -%}
  {%- assign default_subtext = hero_count | append: ' products from Brooks, Hoka, Saucony, Luna and Vibram' -%}
{%- elsif coll_handle contains 'cycling' or coll_handle contains 'ride' or coll_handle contains 'castelli' or hero_title contains 'Cycling' -%}
  {%- assign parent_nav_title = parent_title | default: 'Ride' -%}
  {%- assign parent_nav_url = parent_url | default: routes.collections_url | append: '/cycling' -%}
  {%- assign hero_bg_asset = 'category-accessories.png' -%}
  {%- assign default_subtext = hero_count | append: ' cycling apparel and equipment from Castelli, Camelbak and Giro' -%}
{%- elsif coll_handle contains 'triathlon' or hero_title contains 'Triathlon' -%}
  {%- assign parent_nav_title = parent_title | default: 'Tri' -%}
  {%- assign parent_nav_url = parent_url | default: routes.collections_url | append: '/triathlon' -%}
  {%- assign hero_bg_asset = 'category-apparel.png' -%}
  {%- assign default_subtext = hero_count | append: ' race-proven triathlon essentials and apparel' -%}
{%- elsif coll_handle contains 'fitness' or coll_handle contains 'recover' or hero_title contains 'Fitness' -%}
  {%- assign parent_nav_title = parent_title | default: 'Train & Recover' -%}
  {%- assign parent_nav_url = parent_url | default: routes.collections_url | append: '/fitness' -%}
  {%- assign hero_bg_asset = 'category-accessories.png' -%}
  {%- assign default_subtext = hero_count | append: ' endurance training and recovery products from Hyperice, CEP, and 2XU' -%}
{%- elsif coll_handle contains 'oakley' or hero_title contains 'Oakley' -%}
  {%- assign parent_nav_title = parent_title | default: 'Sunglasses' -%}
  {%- assign parent_nav_url = parent_url | default: routes.collections_url | append: '/oakley' -%}
  {%- assign hero_bg_asset = 'category-sunglasses.png' -%}
  {%- assign default_subtext = hero_count | append: ' performance sports eyewear from Oakley' -%}
{%- endif -%}

<div class="collection-hero-wrap">
  <!-- Breadcrumbs -->
  <nav class="collection-breadcrumbs" aria-label="Breadcrumb">
    <ol class="collection-breadcrumbs__list">
      <li class="collection-breadcrumbs__item">
        <a href="{{ routes.root_url }}" class="collection-breadcrumbs__link">Home</a>
      </li>
      <li class="collection-breadcrumbs__separator" aria-hidden="true">/</li>
      <li class="collection-breadcrumbs__item">
        <a href="{{ parent_nav_url }}" class="collection-breadcrumbs__link">{{ parent_nav_title }}</a>
      </li>
      <li class="collection-breadcrumbs__separator" aria-hidden="true">/</li>
      <li class="collection-breadcrumbs__item collection-breadcrumbs__item--current" aria-current="page">
        {{ hero_title }}
      </li>
    </ol>
  </nav>

  <!-- Hero Banner -->
  <div class="collection-hero-banner{% if show_search_bar %} collection-hero-banner--with-search{% endif %}" role="banner">
    <div class="collection-hero-banner__content">
      <h1 class="collection-hero-banner__title">{{ hero_title }}</h1>
      <p class="collection-hero-banner__subtitle">
        {%- if is_wishlist -%}
          <span data-wishlist-page-count>0 items</span> saved — Brooks, Hoka, Garmin &amp; endurance sports gear ready for dispatch
        {%- elsif subtitle != blank -%}
          {{ subtitle }}
        {%- elsif collection.description != blank -%}
          {{ collection.description | strip_html | truncatewords: 20 }}
        {%- else -%}
          {{ default_subtext }}
        {%- endif -%}
      </p>

      {%- if show_search_bar -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="collection-hero-search">
          <input type="hidden" name="options[prefix]" value="last">
          <div class="collection-hero-search__wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              name="q"
              value="{{ search_terms | escape }}"
              placeholder="Search watches, running shoes, brands (e.g. Forerunner 970, Hoka, Brooks)…"
              class="collection-hero-search__input"
              aria-label="Search products"
              autocomplete="off"
            >
            {%- if search_terms != blank -%}
              <a href="{{ routes.search_url }}" class="collection-hero-search__clear" aria-label="Clear search">✕</a>
            {%- endif -%}
            <button type="submit" class="collection-hero-search__btn">Search</button>
          </div>
        </form>
      {%- endif -%}
    </div>
    
    <div class="collection-hero-banner__visual" aria-hidden="true">
      <img
        src="{{ hero_bg_asset | asset_url }}"
        alt="{{ hero_title | escape }}"
        width="1000"
        height="230"
        loading="eager"
        class="collection-hero-banner__image"
      >
    </div>
  </div>
</div>
