{% comment %}
  Athelin Product Navigation Tabs Snippet
  Matches Figma: Overview, Specifications, Compare models, Reviews (128), Q&A, Shipping & returns
{% endcomment %}

{%- assign raw_tab_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.loox.avg_rating | default: product.metafields.yotpo.reviews_average | default: product.metafields.stamped.reviews_average | default: product.metafields.custom.rating.value | default: product.metafields.custom.rating -%}
{%- assign raw_tab_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: product.metafields.loox.num_reviews | default: product.metafields.yotpo.reviews_count | default: product.metafields.stamped.reviews_count | default: product.metafields.custom.rating_count.value | default: product.metafields.custom.rating_count -%}
{%- assign tab_rating_value = raw_tab_rating | plus: 0.0 -%}
{%- assign tab_rating_count = raw_tab_count | plus: 0 -%}
{%- assign has_real_reviews = false -%}
{%- if tab_rating_value > 0 and tab_rating_count > 0 -%}
  {%- assign has_real_reviews = true -%}
{%- endif -%}

<div class="product-tabs-section" data-product-tabs>
  <!-- Horizontal Tab Bar -->
  <nav class="product-tabs-nav" role="tablist" aria-label="Product Details Tabs">
    <button
      type="button"
      class="product-tab-btn is-active"
      role="tab"
      aria-selected="true"
      data-tab-target="overview"
      id="tab-btn-overview"
    >
      Overview
    </button>
    <button
      type="button"
      class="product-tab-btn"
      role="tab"
      aria-selected="false"
      data-tab-target="specifications"
      id="tab-btn-specifications"
    >
      Specifications
    </button>
    <button
      type="button"
      class="product-tab-btn"
      role="tab"
      aria-selected="false"
      data-tab-target="compare"
      id="tab-btn-compare"
    >
      Compare models
    </button>
    {%- if has_real_reviews -%}
      <button
        type="button"
        class="product-tab-btn"
        role="tab"
        aria-selected="false"
        data-tab-target="reviews"
        id="tab-btn-reviews"
      >
        Reviews ({{ tab_rating_count }})
      </button>
    {%- endif -%}
    <button
      type="button"
      class="product-tab-btn"
      role="tab"
      aria-selected="false"
      data-tab-target="qa"
      id="tab-btn-qa"
    >
      Q&amp;A
    </button>
    <button
      type="button"
      class="product-tab-btn"
      role="tab"
      aria-selected="false"
      data-tab-target="shipping"
      id="tab-btn-shipping"
    >
      Shipping &amp; returns
    </button>
  </nav>

  <!-- Tab Content Panels -->
  <!-- 1. Overview Panel -->
  <div class="product-tab-panel is-active" role="tabpanel" data-tab-panel="overview" aria-labelledby="tab-btn-overview">
    {% render 'product-setup-bundle', product: product %}

    {%- if product.description != blank -%}
      <div class="product-description-container" data-product-description-container style="margin-top: 24px;">
        <div class="product-description-raw" data-product-description-raw style="display: none;">
          {{ product.description }}
        </div>
        <div class="product-description-formatted" data-product-description-formatted>
          <div class="product-overview-card">
            <h3 class="product-overview-card__title">Product Overview &amp; Specifications</h3>
            <div class="product-overview-card__body">
              {{ product.description }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- assign tab_meta = product.title | append: ' ' | append: product.type | append: ' ' | append: product.vendor | downcase -%}
  {%- assign tab_cat = 'gear' -%}
  {%- if tab_meta contains 'garmin' or tab_meta contains 'forerunner' or tab_meta contains 'fenix' or tab_meta contains 'fēnix' or tab_meta contains 'epix' or tab_meta contains 'instinct' or tab_meta contains 'venu' or tab_meta contains 'watch' -%}
    {%- assign tab_cat = 'watch' -%}
  {%- elsif tab_meta contains 'shoe' or tab_meta contains 'hoka' or tab_meta contains 'brooks' or tab_meta contains 'saucony' or tab_meta contains 'vibram' or tab_meta contains 'clifton' or tab_meta contains 'bondi' or tab_meta contains 'ghost' or tab_meta contains 'glycerin' -%}
    {%- assign tab_cat = 'shoe' -%}
  {%- elsif tab_meta contains 'oakley' or tab_meta contains 'sunglass' or tab_meta contains 'eyewear' -%}
    {%- assign tab_cat = 'eyewear' -%}
  {%- endif -%}

  <!-- 2. Specifications Panel -->
  <div class="product-tab-panel" role="tabpanel" data-tab-panel="specifications" aria-labelledby="tab-btn-specifications">
    <div class="product-overview-card">
      <h3 class="product-overview-card__title">Technical Specifications</h3>
      <table class="product-specs-table">
        <tbody>
          <tr>
            <th>Brand</th>
            <td>{{ product.vendor | default: 'Athelin Athletics' }}</td>
          </tr>
          <tr>
            <th>Product Category</th>
            <td>{{ product.type | default: 'Endurance Performance' }}</td>
          </tr>
          <tr>
            <th>SKU / Model</th>
            <td>{{ product.selected_or_first_available_variant.sku | default: 'ATH-2026-X' }}</td>
          </tr>
          <tr>
            <th>Barcode</th>
            <td>{{ product.selected_or_first_available_variant.barcode | default: '8901234567890' }}</td>
          </tr>
          <tr>
            <th>Warranty</th>
            <td>Authorised Brand Warranty · Instant digital registration</td>
          </tr>
          <tr>
            <th>Box Contents</th>
            <td>
              {%- if tab_cat == 'watch' -%}
                1x {{ product.title }}, USB-C Charging/Data Cable, Quick Start Documentation, Warranty Card
              {%- elsif tab_cat == 'shoe' -%}
                1x Pair {{ product.title }}, Original Brand Box, Athelin Fit &amp; Authenticity Card
              {%- elsif tab_cat == 'eyewear' -%}
                1x {{ product.title }}, Hard Protective Vault Case, Microbag Cleaning Pouch, Nosepad Kit
              {%- else -%}
                1x {{ product.title }}, Manufacturer Documentation, Authenticity &amp; Warranty Card
              {%- endif -%}
            </td>
          </tr>
        </tbody>
      </table>
      <div data-specs-extra-container style="margin-top: 16px;"></div>
    </div>
  </div>

  <!-- 3. Compare Models Panel -->
  <div class="product-tab-panel" id="product-tab-compare" role="tabpanel" data-tab-panel="compare" aria-labelledby="tab-btn-compare">
    <div class="product-overview-card pdp-compare-card" data-pdp-compare-section>
      <div class="pdp-compare-card__header">
        <div>
          <span class="pdp-compare-card__eyebrow">SIDE-BY-SIDE COMPARISON</span>
          <h3 class="product-overview-card__title" style="margin: 2px 0 4px 0;">
            Compare {{ product.title }} With Other Models
          </h3>
          <p class="pdp-compare-card__sub">
            Add this model to your comparison list or launch the dedicated Compare Models page to search and compare any product in our store.
          </p>
        </div>

        <div class="pdp-compare-card__actions">
          <button
            type="button"
            class="pdp-compare-card__btn pdp-compare-card__btn--outline"
            data-compare-btn
          >
            + Add to Compare
          </button>
          <a
            href="/pages/compare"
            class="pdp-compare-card__btn pdp-compare-card__btn--primary"
            data-compare-add-and-go
          >
            Compare Models Page <span data-compare-count-badge></span> →
          </a>
        </div>
      </div>

      <!-- Inline Comparison Matrix Inside the Compare Tab -->
      <div class="pdp-compare-card__table-wrap" data-pdp-compare-table-wrap></div>

      <!-- Footer CTA to Search Any Product on Dedicated Compare Page -->
      <div class="pdp-compare-card__footer">
        <span>Want to compare against a specific watch, shoe, or gear model?</span>
        <a href="/pages/compare" class="pdp-compare-card__footer-link" data-compare-add-and-go>
          Search &amp; Add Any Product on Compare Page →
        </a>
      </div>

      {%- comment -%} Provide related same-brand / same-collection products for instant comparison {%- endcomment -%}
      {%- assign rel_source = product.collections.first.products | default: collections['all'].products -%}
      <script type="application/json" data-pdp-related-compare-json>
        [
          {%- assign rel_count = 0 -%}
          {%- for rp in rel_source limit: 30 -%}
            {%- if rp.id != product.id and rel_count < 3 -%}
              {%- assign rp_var = rp.selected_or_first_available_variant -%}
              {%- assign rp_emi = rp.price | divided_by: 3 -%}
              {%- if rel_count > 0 -%},{%- endif -%}
              {
                "id": {{ rp.id | append: '' | json }},
                "handle": {{ rp.handle | json }},
                "title": {{ rp.title | json }},
                "vendor": {{ rp.vendor | default: 'ATHELIN' | json }},
                "type": {{ rp.type | default: 'Endurance Gear' | json }},
                "url": {{ rp.url | json }},
                "image": {% if rp.featured_image %}{{ rp.featured_image | image_url: width: 500 | json }}{% else %}{{ 'product-garmin-1.png' | asset_url | json }}{% endif %},
                "price": {{ rp.price | money | strip_html | json }},
                "priceRaw": {{ rp.price | json }},
                "emi": {{ rp_emi | money | strip_html | append: '/mo' | json }},
                "available": {{ rp.available | json }},
                "variantId": {{ rp_var.id | append: '' | json }},
                "sku": {{ rp_var.sku | default: rp.handle | upcase | json }},
                "summary": {{ rp.description | strip_html | strip_newlines | truncate: 140 | json }}
              }
              {%- assign rel_count = rel_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      </script>
    </div>
  </div>

  <!-- 4. Reviews Panel (Only rendered when product has real rating) -->
  {%- if has_real_reviews -%}
    <div class="product-tab-panel" id="product-tab-reviews" role="tabpanel" data-tab-panel="reviews" aria-labelledby="tab-btn-reviews">
      <div class="product-overview-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <h3 class="product-overview-card__title" style="margin: 0;">Verified Athlete Reviews ({{ tab_rating_count }})</h3>
          <span style="font-size: 11px; font-weight: 700; color: #10b981;">★ {{ tab_rating_value | round: 1 }} Overall Score</span>
        </div>
        <div class="product-overview-card__body">
          {%- if product.metafields.judgeme.widget != blank -%}
            {{ product.metafields.judgeme.widget }}
          {%- elsif product.metafields.spr.reviews != blank -%}
            {{ product.metafields.spr.reviews }}
          {%- else -%}
            <p class="product-overview-card__p">Rated {{ tab_rating_value | round: 1 }} out of 5 based on {{ tab_rating_count }} verified customer {{ tab_rating_count | pluralize: 'review', 'reviews' }}.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- 5. Q&A Panel -->
  <div class="product-tab-panel" role="tabpanel" data-tab-panel="qa" aria-labelledby="tab-btn-qa">
    <div class="product-overview-card">
      <h3 class="product-overview-card__title">Frequently Asked Questions (12)</h3>
      <div class="product-overview-card__body">
        <p class="product-overview-card__p"><strong>Q: Is this authentic with manufacturer warranty?</strong><br>A: Yes, Athelin is an authorised dealer. Your device warranty is automatically registered upon order confirmation.</p>
        <p class="product-overview-card__p"><strong>Q: What is the return and exchange window?</strong><br>A: 10-day complimentary door-to-door returns. We send a courier to collect the package at zero extra cost.</p>
      </div>
    </div>
  </div>

  <!-- 6. Shipping & Returns Panel -->
  <div class="product-tab-panel" role="tabpanel" data-tab-panel="shipping" aria-labelledby="tab-btn-shipping">
    <div class="product-overview-card">
      <h3 class="product-overview-card__title">Shipping &amp; Delivery Information</h3>
      <div class="product-overview-card__body">
        <p class="product-overview-card__p"><strong>Fast Track Metro Dispatch:</strong> Orders placed before 2:00 PM are handed over to express couriers same-day.</p>
        <p class="product-overview-card__p"><strong>10-Day Hassle-Free Returns:</strong> If size or fit does not suit you, we pick up directly from your doorstep with no return fees.</p>
        <p class="product-overview-card__p"><strong>Payment Methods:</strong> Instant UPI, GPay, PhonePe, Debit/Credit cards, and 3/6-month No-Cost EMI.</p>
      </div>
    </div>
  </div>
</div>
