{% doc %}
  Renders a shimmer skeleton loading card for products.
  Provides high-fidelity layout feedback matching the live product card.
{% enddoc %}

<div class="product-card product-card--skeleton" aria-hidden="true">
  <div class="product-card__image-wrap skeleton-box skeleton-shimmer">
    <div class="product-card__badge-skeleton skeleton-box"></div>
  </div>
  <div class="product-card__details">
    <div class="skeleton-line skeleton-line--sm skeleton-shimmer" style="width: 35%; margin-bottom: 6px;"></div>
    <div class="skeleton-line skeleton-line--xs skeleton-shimmer" style="width: 50%; margin-bottom: 8px;"></div>
    <div class="skeleton-line skeleton-line--md skeleton-shimmer" style="width: 80%; margin-bottom: 8px;"></div>
    <div class="product-card__price-row" style="margin-bottom: 10px;">
      <div class="skeleton-line skeleton-line--sm skeleton-shimmer" style="width: 45%;"></div>
      <div class="skeleton-line skeleton-line--xs skeleton-shimmer" style="width: 35%;"></div>
    </div>
    <div class="product-card__swatches" style="display: flex; gap: 6px;">
      <div class="skeleton-circle skeleton-shimmer" style="width: 10px; height: 10px; border-radius: 50%;"></div>
      <div class="skeleton-circle skeleton-shimmer" style="width: 10px; height: 10px; border-radius: 50%;"></div>
      <div class="skeleton-circle skeleton-shimmer" style="width: 10px; height: 10px; border-radius: 50%;"></div>
    </div>
  </div>
</div>
