{% doc %}
  Renders the Athelin site preloader with the black geometric ATHELIN logo
  revealing progressively from left to right on a clean white canvas.
{% enddoc %}

<div id="site-preloader" class="site-preloader" aria-hidden="true">
  <div class="site-preloader__inner">
    <div class="site-preloader__logo-reveal">
      <img
        src="{{ 'athelin-logo.png' | asset_url }}"
        alt="Athelin"
        width="240"
        height="59"
        class="site-preloader__img"
      >
    </div>
  </div>
</div>

<script>
  (function() {
    var preloader = document.getElementById('site-preloader');
    if (!preloader) return;

    function hidePreloader() {
      if (preloader.classList.contains('site-preloader--hidden')) return;
      preloader.classList.add('site-preloader--fade-out');
      setTimeout(function() {
        preloader.classList.add('site-preloader--hidden');
        document.body.classList.add('site-loaded');
      }, 450);
    }

    if (document.readyState === 'complete') {
      setTimeout(hidePreloader, 950);
    } else {
      window.addEventListener('load', function() {
        setTimeout(hidePreloader, 950);
      });
      setTimeout(hidePreloader, 2000);
    }
  })();
</script>
