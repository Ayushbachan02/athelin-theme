{% doc %}
  Renders the collection filter bar containing active filter pill badges,
  mobile filter trigger, and custom sort dropdown.
{% enddoc %}

<div class="collection-toolbar" data-collection-toolbar>
  <!-- Left Side: Mobile Filter Button & Active Filter Badges -->
  <div class="collection-toolbar__left">
    <!-- Mobile Filter Open Button -->
    <button
      type="button"
      class="collection-toolbar__filter-btn"
      data-mobile-filter-open
      aria-label="Open filter options"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="21" x2="4" y2="14"></line>
        <line x1="4" y1="10" x2="4" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12" y2="3"></line>
        <line x1="20" y1="21" x2="20" y2="16"></line>
        <line x1="20" y1="12" x2="20" y2="3"></line>
        <line x1="1" y1="14" x2="7" y2="14"></line>
        <line x1="9" y1="8" x2="15" y2="8"></line>
        <line x1="17" y1="16" x2="23" y2="16"></line>
      </svg>
      <span>Filters</span>
      <span class="collection-toolbar__filter-badge" data-filter-count style="display: none;">0</span>
    </button>

    <!-- Active Pills Container (Dynamically populated by JS when filters are active) -->
    <div class="collection-active-pills" data-active-pills></div>
  </div>

  <!-- Right Side: Sort Select Pill -->
  <div class="collection-toolbar__right">
    <div class="collection-sort">
      <label for="collection-sort-select" class="visually-hidden">Sort products</label>
      <div class="collection-sort__wrapper">
        <select
          id="collection-sort-select"
          class="collection-sort__select"
          data-collection-sort
          aria-label="Sort products"
        >
          <option value="manual" selected>Sort: Recommended ▾</option>
          <option value="price-ascending">Sort: Price, low to high</option>
          <option value="price-descending">Sort: Price, high to low</option>
          <option value="created-descending">Sort: Date, new to old</option>
          <option value="best-selling">Sort: Best selling</option>
        </select>
        <span class="collection-sort__arrow" aria-hidden="true">▾</span>
      </div>
    </div>
  </div>
</div>
