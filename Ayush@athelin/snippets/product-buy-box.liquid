{% comment %}
  Athelin Product Buy Box Snippet
  Matches Figma: Brand logo, Title, Stars, Price, Lime EMI Pill, Swatches,
  Live Stock, Delivery Estimator, Add to Cart, Compare, Trust Badges, WhatsApp Support.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign vendor_lower = product.vendor | default: '' | downcase -%}

<div class="product-buy-box" data-product-buy-box>
  <!-- 1. Brand Logo / Vendor Identification -->
  <div class="product-buy-box__brand-wrap">
    {%- if vendor_lower contains 'nike' -%}
      <svg class="product-buy-box__brand-logo" viewBox="0 0 50 18" fill="#000000" aria-label="Nike">
        <path d="M11.5 17.5C7.2 17.5 3.5 15.6 1.1 12.5C-0.8 10 -0.3 6.5 2.1 4.2C3.3 3.1 5 2.3 6.8 1.9C6.4 2.8 6.2 3.8 6.2 4.9C6.2 9.6 10.6 13.5 16.5 14.1L49 2.5L16.2 16.7C14.7 17.2 13.1 17.5 11.5 17.5Z"/>
      </svg>
    {%- elsif vendor_lower contains 'garmin' -%}
      <img src="{{ 'brand-garmin.png' | asset_url }}" alt="Garmin" class="product-buy-box__brand-logo" width="80" height="20">
    {%- elsif vendor_lower contains 'oakley' -%}
      <img src="{{ 'brand-oakley.png' | asset_url }}" alt="Oakley" class="product-buy-box__brand-logo" width="80" height="20">
    {%- elsif vendor_lower contains 'adidas' -%}
      <img src="{{ 'brand-adidas.png' | asset_url }}" alt="Adidas" class="product-buy-box__brand-logo" width="70" height="20">
    {%- elsif vendor_lower contains 'hoka' -%}
      <img src="{{ 'brand-hoka.png' | asset_url }}" alt="Hoka" class="product-buy-box__brand-logo" width="70" height="20">
    {%- elsif vendor_lower contains 'brooks' -%}
      <img src="{{ 'brand-brooks.png' | asset_url }}" alt="Brooks" class="product-buy-box__brand-logo" width="80" height="20">
    {%- elsif vendor_lower contains 'saucony' -%}
      <img src="{{ 'brand-saucony.png' | asset_url }}" alt="Saucony" class="product-buy-box__brand-logo" width="80" height="20">
    {%- elsif vendor_lower contains 'shokz' -%}
      <img src="{{ 'brand-shokz.png' | asset_url }}" alt="Shokz" class="product-buy-box__brand-logo" width="80" height="20">
    {%- elsif vendor_lower contains 'hyperice' -%}
      <img src="{{ 'brand-hyperice.png' | asset_url }}" alt="Hyperice" class="product-buy-box__brand-logo" width="80" height="20">
    {%- else -%}
      <span class="product-buy-box__brand-name">{{ product.vendor | default: 'ATHELIN' }}</span>
    {%- endif -%}
  </div>

  <!-- 2. Product Title -->
  <h1 class="product-buy-box__title">{{ product.title }}</h1>

  <!-- 3. Real Review Rating Stars (Only shown when product has real rating) -->
  {%- assign raw_pdp_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.loox.avg_rating | default: product.metafields.yotpo.reviews_average | default: product.metafields.stamped.reviews_average | default: product.metafields.custom.rating.value | default: product.metafields.custom.rating -%}
  {%- assign raw_pdp_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: product.metafields.loox.num_reviews | default: product.metafields.yotpo.reviews_count | default: product.metafields.stamped.reviews_count | default: product.metafields.custom.rating_count.value | default: product.metafields.custom.rating_count -%}
  {%- assign pdp_rating_value = raw_pdp_rating | plus: 0.0 -%}
  {%- assign pdp_rating_count = raw_pdp_count | plus: 0 -%}
  {%- if pdp_rating_value > 0 and pdp_rating_count > 0 -%}
    {%- assign pdp_stars = '' -%}
    {%- assign pdp_rounded = pdp_rating_value | round -%}
    {%- if pdp_rounded > 5 -%}{%- assign pdp_rounded = 5 -%}{%- endif -%}
    {%- for i in (1..5) -%}
      {%- if i <= pdp_rounded -%}
        {%- assign pdp_stars = pdp_stars | append: '★' -%}
      {%- else -%}
        {%- assign pdp_stars = pdp_stars | append: '☆' -%}
      {%- endif -%}
    {%- endfor -%}
    <a href="#product-tab-reviews" class="product-buy-box__reviews">
      <span class="product-buy-box__stars" aria-hidden="true">{{ pdp_stars }}</span>
      <span class="product-buy-box__rating-meta">{{ pdp_rating_value | round: 1 }} · {{ pdp_rating_count }} {{ pdp_rating_count | pluralize: 'review', 'reviews' }}</span>
    </a>
  {%- endif -%}

  <!-- 4. Price & Lime EMI Pill -->
  <div class="product-buy-box__price-wrap">
    <div class="product-buy-box__price-row">
      <span class="product-buy-box__price" data-product-price>{{ current_variant.price | money }}</span>
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="product-buy-box__compare-price">{{ current_variant.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    <!-- Figma Accent Pill: Electric Lime #d4f933 -->
    {%- assign emi_amount = current_variant.price | divided_by: 3 -%}
    <div class="product-buy-box__emi-pill">
      <span>or <span data-product-emi>{{ emi_amount | money }}/mo</span> · No Cost EMI</span>
      <span class="product-buy-box__emi-info" title="Zero cost 3-month equal installment plans available at checkout">ⓘ</span>
    </div>
  </div>

  <!-- 5. Product Form & Variant Selector -->
  {% form 'product', product, id: 'product-form' %}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
    <input type="hidden" name="quantity" value="1">

    {%- unless product.has_only_default_variant -%}
      <div class="product-buy-box__variants" data-pdp-variant-picker>
        {%- for option in product.options_with_values -%}
          {%- assign opt_name_low = option.name | downcase | strip -%}
          {%- assign opt_index = forloop.index0 -%}
          {%- assign is_color_opt = false -%}
          {%- if opt_name_low contains 'color' or opt_name_low contains 'colour' or opt_name_low contains 'shade' -%}
            {%- assign is_color_opt = true -%}
          {%- endif -%}

          <div class="pdp-option-group" data-option-group data-option-index="{{ opt_index }}" data-option-name="{{ option.name | escape }}">
            <div class="pdp-option-group__header">
              <div class="pdp-option-group__title-wrap">
                <span class="pdp-option-group__label">{{ option.name }}</span>
                <span class="pdp-option-group__sep">:</span>
                <span class="pdp-option-group__selected" data-option-selected-val="{{ opt_index }}" data-locked-val="{{ option.selected_value | escape }}">{{ option.selected_value }}</span>
              </div>
              {%- if is_color_opt -%}
                {%- assign sel_color_avail = false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[opt_index] == option.selected_value and variant.available -%}
                    {%- assign sel_color_avail = true -%}
                  {%- endif -%}
                {%- endfor -%}
                <span class="pdp-option-group__status-badge{% unless sel_color_avail %} is-soldout{% endunless %}" data-option-header-status="{{ opt_index }}">
                  {%- if sel_color_avail -%}In stock{%- else -%}Sold out{%- endif -%}
                </span>
              {%- elsif opt_name_low contains 'size' -%}
                <span class="pdp-option-group__hint">Select {{ option.name | downcase }}</span>
              {%- endif -%}
            </div>

            {%- if is_color_opt -%}
              <div class="pdp-color-grid" role="radiogroup" aria-label="{{ option.name | escape }}">
                {%- for value in option.values -%}
                  {%- assign rep_variant = nil -%}
                  {%- assign any_available_for_val = false -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.options[opt_index] == value -%}
                      {%- if rep_variant == nil -%}
                        {%- assign rep_variant = variant -%}
                      {%- endif -%}
                      {%- if variant.featured_image and rep_variant.featured_image == nil -%}
                        {%- assign rep_variant = variant -%}
                      {%- endif -%}
                      {%- if variant.available -%}
                        {%- assign any_available_for_val = true -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- assign val_low = value | downcase -%}
                  {%- assign dot_hex = '#18181b' -%}
                  {%- if val_low contains 'white' or val_low contains 'snow' or val_low contains 'ivory' -%}
                    {%- assign dot_hex = '#ffffff' -%}
                  {%- elsif val_low contains 'neon' or val_low contains 'lime' or val_low contains 'volt' -%}
                    {%- assign dot_hex = '#d4f933' -%}
                  {%- elsif val_low contains 'yellow' or val_low contains 'gold' or val_low contains 'citron' -%}
                    {%- assign dot_hex = '#eab308' -%}
                  {%- elsif val_low contains 'teal' or val_low contains 'petrol' or val_low contains 'cyan' or val_low contains 'aqua' -%}
                    {%- assign dot_hex = '#0d9488' -%}
                  {%- elsif val_low contains 'blue' or val_low contains 'navy' or val_low contains 'ocean' or val_low contains 'cobalt' -%}
                    {%- assign dot_hex = '#1e3a8a' -%}
                  {%- elsif val_low contains 'red' or val_low contains 'crimson' or val_low contains 'burgundy' -%}
                    {%- assign dot_hex = '#dc2626' -%}
                  {%- elsif val_low contains 'green' or val_low contains 'olive' or val_low contains 'sage' or val_low contains 'mint' -%}
                    {%- assign dot_hex = '#15803d' -%}
                  {%- elsif val_low contains 'orange' or val_low contains 'coral' or val_low contains 'amber' or val_low contains 'cerise' -%}
                    {%- assign dot_hex = '#ea580c' -%}
                  {%- elsif val_low contains 'purple' or val_low contains 'violet' or val_low contains 'lavender' or val_low contains 'dusk' -%}
                    {%- assign dot_hex = '#7e22ce' -%}
                  {%- elsif val_low contains 'pink' or val_low contains 'rose' or val_low contains 'magenta' -%}
                    {%- assign dot_hex = '#ec4899' -%}
                  {%- elsif val_low contains 'brown' or val_low contains 'tan' or val_low contains 'sand' or val_low contains 'beige' -%}
                    {%- assign dot_hex = '#78350f' -%}
                  {%- elsif val_low contains 'silver' or val_low contains 'grey' or val_low contains 'gray' or val_low contains 'slate' or val_low contains 'titanium' -%}
                    {%- assign dot_hex = '#94a3b8' -%}
                  {%- endif -%}

                  <button
                    type="button"
                    class="pdp-color-option{% if option.selected_value == value %} is-selected{% endif %}{% unless any_available_for_val %} is-soldout{% endunless %}"
                    data-pdp-option-btn
                    data-option-index="{{ opt_index }}"
                    data-option-value="{{ value | escape }}"
                    data-option-available="{% if any_available_for_val %}true{% else %}false{% endif %}"
                    role="radio"
                    aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                    aria-label="{{ option.name | escape }}: {{ value | escape }}{% unless any_available_for_val %} (Sold out){% endunless %}"
                    title="{{ value | escape }}{% unless any_available_for_val %} — Sold out{% endunless %}"
                  >
                    <span class="pdp-color-option__media">
                      {%- if rep_variant and rep_variant.featured_image -%}
                        <img
                          src="{{ rep_variant.featured_image | image_url: width: 140, height: 140 }}"
                          alt="{{ value | escape }}"
                          class="pdp-color-option__img"
                          width="48"
                          height="48"
                          loading="lazy"
                        >
                      {%- else -%}
                        <span
                          class="pdp-color-option__dot"
                          style="background-color: {{ dot_hex }};{% if dot_hex == '#ffffff' %} border: 1px solid #cbd5e1;{% endif %}"
                        ></span>
                      {%- endif -%}
                    </span>
                  </button>
                {%- endfor -%}
              </div>

            {%- else -%}
              <div class="pdp-pill-grid" role="radiogroup" aria-label="{{ option.name | escape }}">
                {%- for value in option.values -%}
                  {%- assign combo_available = false -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.options[opt_index] == value -%}
                      {%- assign matches_other_opts = true -%}
                      {%- if opt_index != 0 and product.options.size > 0 and variant.option1 != current_variant.option1 -%}
                        {%- assign matches_other_opts = false -%}
                      {%- endif -%}
                      {%- if opt_index != 1 and product.options.size > 1 and variant.option2 != current_variant.option2 -%}
                        {%- assign matches_other_opts = false -%}
                      {%- endif -%}
                      {%- if matches_other_opts and variant.available -%}
                        {%- assign combo_available = true -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <button
                    type="button"
                    class="pdp-pill-option{% if option.selected_value == value %} is-selected{% endif %}{% unless combo_available %} is-soldout{% endunless %}"
                    data-pdp-option-btn
                    data-option-index="{{ opt_index }}"
                    data-option-value="{{ value | escape }}"
                    data-option-available="{% if combo_available %}true{% else %}false{% endif %}"
                    role="radio"
                    aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                    title="{{ option.name | escape }}: {{ value | escape }}{% unless combo_available %} (Sold out){% endunless %}"
                  >
                    <span class="pdp-pill-option__text">{{ value }}</span>
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <script type="application/json" data-pdp-variants-json>
          [
            {%- for variant in product.variants -%}
              {%- assign v_emi = variant.price | divided_by: 3 -%}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }},
                "options": {{ variant.options | json }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price | json }},
                "price_formatted": {{ variant.price | money | strip_html | json }},
                "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
                "compare_price_formatted": {{ variant.compare_at_price | money | strip_html | json }},
                "emi_formatted": {{ v_emi | money | strip_html | append: '/mo' | json }},
                "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% elsif variant.featured_media and variant.featured_media.preview_image %}{{ variant.featured_media.preview_image | image_url: width: 1200 | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </div>
    {%- endunless -%}

    <!-- 6. Live Stock Indicator -->
    <div class="product-buy-box__stock-indicator">
      <span class="product-buy-box__stock-dot{% unless current_variant.available %} is-soldout{% endunless %}" data-stock-dot></span>
      <span data-stock-text>
        {%- if current_variant.available -%}
          In stock · dispatched today
        {%- else -%}
          Sold out · currently unavailable
        {%- endif -%}
      </span>
    </div>

    <!-- 7. Delivery Estimator Box -->
    <div class="product-buy-box__delivery-box">
      <span class="product-buy-box__delivery-text">
        Deliver to <strong data-pincode-value>121003</strong> — <span data-delivery-date>Thu 18 Sep</span>
      </span>
      <button type="button" class="product-buy-box__pincode-trigger" data-pincode-trigger>Change</button>
    </div>

    <!-- 8. Action Buttons (Add to Cart + Wishlist + Compare) -->
    {%- assign pdp_img = '' -%}
    {%- if product.featured_image -%}
      {%- assign pdp_img = product.featured_image | image_url: width: 600 -%}
    {%- else -%}
      {%- assign pdp_img = 'product-garmin-1.png' | asset_url -%}
    {%- endif -%}
    <div
      class="product-buy-box__cta-row"
      data-product-card
      data-pdp-compare-source
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-product-title="{{ product.title | escape }}"
      data-product-vendor="{{ product.vendor | default: 'ATHELIN' | escape }}"
      data-product-type="{{ product.type | default: 'Endurance Gear' | escape }}"
      data-product-url="{{ product.url | escape }}"
      data-product-image="{{ pdp_img | escape }}"
      data-product-price="{{ current_variant.price | money | strip_html | escape }}"
      data-price="{{ current_variant.price }}"
      data-product-emi="{{ emi_amount | money | strip_html | append: '/mo' | escape }}"
      data-product-specs="{{ product.type | default: 'Endurance Sports Gear' | escape }}"
      data-product-sku="{{ current_variant.sku | default: product.handle | upcase | escape }}"
      data-product-summary="{{ product.description | strip_html | strip_newlines | truncate: 140 | escape }}"
      data-available="{% if current_variant.available %}true{% else %}false{% endif %}"
      data-variant-id="{{ current_variant.id }}"
    >
      <button
        type="submit"
        class="product-buy-box__btn-cart"
        data-add-to-cart-btn
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {%- if current_variant.available -%}
          Add to cart
        {%- else -%}
          Sold out
        {%- endif -%}
      </button>

      <button
        type="button"
        class="product-buy-box__btn-wishlist"
        data-wishlist-btn
        aria-label="Save {{ product.title | escape }} to wishlist"
        title="Save to Wishlist"
      >
        <svg class="icon-heart-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>

      <button
        type="button"
        class="product-buy-box__btn-compare"
        data-compare-btn
        aria-label="Add {{ product.title | escape }} to compare"
      >
        + Compare
      </button>
    </div>

    <!-- Live Compare Tray Link on Every Product Page -->
    <div class="product-buy-box__compare-tray" data-pdp-compare-tray>
      <button type="button" class="product-buy-box__compare-action" data-compare-add-and-go>
        <span>⇄ Compare this model side-by-side</span>
        <span class="product-buy-box__compare-link-text">Open Compare Page <span data-compare-count-badge></span> →</span>
      </button>
    </div>
  {% endform %}

  <!-- 9. Trust & Dealer Guarantees -->
  <div class="product-buy-box__trust-row">
    Warranty registered for you · 10-day returns, we pay the courier
  </div>

  <div class="product-buy-box__dealer-row">
    <span>Authorised {{ product.vendor | default: 'Athelin' }} Dealer · Free shipping · Pay by UPI, card or EMI</span>
    <div class="product-buy-box__payment-icons">
      <!-- UPI & Payment Icons -->
      <svg class="product-buy-box__payment-icon" viewBox="0 0 38 24" fill="none" aria-label="UPI Payment">
        <rect width="38" height="24" rx="4" fill="#097939"/>
        <path d="M19 6L24 18H20.5L19 14.5H15L19 6Z" fill="#FFFFFF"/>
      </svg>
      <svg class="product-buy-box__payment-icon" viewBox="0 0 38 24" fill="none" aria-label="GPay">
        <rect width="38" height="24" rx="4" fill="#5F6368"/>
        <path d="M12 12C12 8.7 14.7 6 18 6C19.7 6 21.1 6.7 22.1 7.7L20.2 9.6C19.6 9 18.9 8.7 18 8.7C16.2 8.7 14.7 10.2 14.7 12C14.7 13.8 16.2 15.3 18 15.3C19.3 15.3 20.3 14.6 20.7 13.7H18V11.2H23.2C23.3 11.6 23.4 12 23.4 12.5C23.4 15.8 21.1 18 18 18C14.7 18 12 15.3 12 12Z" fill="#FFFFFF"/>
      </svg>
      <svg class="product-buy-box__payment-icon" viewBox="0 0 38 24" fill="none" aria-label="Paytm">
        <rect width="38" height="24" rx="4" fill="#002E6E"/>
        <circle cx="19" cy="12" r="5" fill="#00BAF2"/>
      </svg>
    </div>
  </div>

  <!-- 10. WhatsApp & Store Fitting Support -->
  <div class="product-buy-box__support-line">
    <span>Need help choosing? Message us on </span>
    <a
      href="https://wa.me/?text={{ 'Hi Athelin, I would like guidance on ' | append: product.title | url_encode }}"
      target="_blank"
      rel="noopener noreferrer"
      class="product-buy-box__support-link"
    >
      💬 WhatsApp
    </a>
    <span>·</span>
    <a href="#store-fitting" class="product-buy-box__support-link">Book a fitting in store</a>
  </div>
</div>
