{% comment %}
  Athelin Dynamic Product Detail Page (PDP)
  Matches Figma: 03-product-page-desktop 2 (Node 167:807)
  Full-width laptop layout with real Shopify data, interactive gallery,
  buy box with lime EMI pill, swatches, tabs, setup bundle, and sticky conversion bar.
{% endcomment %}

{{ 'athelin-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'athelin-product.js' | asset_url }}" defer="defer"></script>

{% block 'container', tag: 'div' %}
  <div class="product-page" data-product-page>
    <!-- 1. Breadcrumbs Navigation -->
    {% render 'product-breadcrumbs', product: product, collection: collection %}

    <!-- 2. Hero Section: Left Vertical Gallery Strip & Right Buy Box Card -->
    <div class="product-hero">
      {% render 'product-gallery', product: product %}
      {% render 'product-buy-box', product: product %}
    </div>

    <!-- 3. Navigation Tabs: Overview (Why this product + Complete your setup), Specs, Compare, Reviews, Q&A, Shipping -->
    {% render 'product-tabs', product: product %}

    <!-- 4. Sticky Conversion Bottom Bar -->
    {% render 'product-sticky-bar', product: product %}
  </div>
{% endblock %}
