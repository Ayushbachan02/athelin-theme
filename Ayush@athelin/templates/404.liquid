{% block 'container', tag: 'div' %}
  <div data-404-wishlist-wrapper style="display: none;">
    {% render 'wishlist-content' %}
  </div>

  <div data-404-compare-wrapper style="display: none;">
    {% render 'compare-content' %}
  </div>

  <div data-404-contact-wrapper style="display: none;">
    {% render 'contact-content' %}
  </div>

  <div class="athelin-standard-page" data-404-default-wrapper>
    <div class="cart-empty-state" style="margin-top: 32px;">
      <h1 class="cart-empty-state__title">{{ '404.title' | t }}</h1>
      <p class="cart-empty-state__desc">
        {{ '404.not_found' | t }}
      </p>
      <div class="cart-empty-state__actions">
        <a href="{{ routes.all_products_collection_url }}" class="btn-pill btn-pill--dark">
          {{ '404.back_to_shopping' | t }}
        </a>
        <a href="{{ routes.root_url }}" class="btn-pill btn-pill--outline">
          Return Home
        </a>
      </div>
    </div>
  </div>
{% endblock %}

{% block 'trust-pillars' %}{% endblock %}
